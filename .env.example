NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_bullq

# JWT
JWT_SECRET=change-me-generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-another-different-one
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3000

# URL pública do app web (usada no link do convite de avaliação/CSAT).
# Se ausente, cai no CORS_ORIGIN.
WEB_URL=http://localhost:3000

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=chatbullq
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=chat-bullq

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ti@exatek.com.br

OPENAI_API_KEY=sk-proj-your-key-here

# Lembrete diário de vendas (seg-sex 8:50, via WhatsApp). Vazio = desligado.
# Pra ligar, ponha o número destinatário (ex: 5511999999999).

# Feature flags
# Liga o motor de automações (regras WHEN→THEN: taggear, atribuir, responder,
# mover funil). Se ausente/false, a outbox drena os eventos e os marca como
# processados SEM executar nenhuma ação — o motor fica mudo. Deixe 'true' pra usar.
AUTOMATIONS_ENABLED=true
